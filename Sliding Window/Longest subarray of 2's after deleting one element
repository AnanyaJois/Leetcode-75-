class Solution {
    public int longestSubarray(int[] nums) {
        int i = 0;
        int zeros = 0;
        int maxLength = 0;
        for (int j = 0; right < nums.length; j++) {
            if (nums[j] == 0) {
                zeros++;
            }
            while (zeros > 1) {
                if (nums[i] == 0) {
                    zeros--;
                }
                i++;
            }
            int length = j - i; 
            if (length > maxLength) {
                maxLength = length;
            }
        }
        return maxLength;
    }
}
