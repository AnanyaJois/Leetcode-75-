int* productExceptSelf(int* nums, int numsSize, int* returnSize) {
    static int answer[100];
    int prefix = 1;
    for (int i = 0; i < numsSize; i++) {
        answer[i] = prefix;
        prefix *= nums[i];
    }
    int suffix = 1;
    for (int i = numsSize - 1; i >= 0; i--) {
        answer[i] *= suffix;
        suffix *= nums[i];
    }
    *returnSize = numsSize;
    return answer;
}
