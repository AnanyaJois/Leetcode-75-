#include <string.h>
char* reverseWords(char* s) {
    static char result[10001];
    int len = strlen(s);
    int pos = 0;
    int i = len - 1;
    while (i >= 0) {
        while (i >= 0 && s[i] == ' ') {
            i--;
        }
        if (i < 0) break;
        int end = i;
        while (i >= 0 && s[i] != ' ') {
            i--;
        }
        int start = i + 1;
        if (pos > 0) {
            result[pos++] = ' ';
        }
        for (int j = start; j <= end; j++) {
            result[pos++] = s[j];
        }
    }
    result[pos] = '\0';
    return result;
}
