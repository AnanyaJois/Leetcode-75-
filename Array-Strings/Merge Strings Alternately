#include <string.h>
#include <stdio.h>
#include <stdlib.h>
char word1[101], word2[101];
char * mergeAlternately(char * word1, char * word2) {
    int len1 = strlen(word1);
    int len2 = strlen(word2);
    int mergedLength = len1 + len2;
    char *merged = (char *)malloc((mergedLength + 1) * sizeof(char));
    if (merged == NULL) {
        return NULL; 
    }
    int i = 0, j = 0, k = 0;
    while (i < len1 && j < len2) {
        merged[k++] = word1[i++];
        merged[k++] = word2[j++];
    }
    while (i < len1) {
        merged[k++] = word1[i++];
    }
    while (j < len2) {
        merged[k++] = word2[j++];
    }
    merged[k] = '\0';
    return merged;
    printf("Enter first string: ");
    scanf("%100s", word1); 
    printf("Enter second string: ");
    scanf("%100s", word2);
    char *result = mergeAlternately(word1, word2);
    printf("Merged string: %s\n", result);
    free(result);
    return 0;
}
